<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gklx.mopga.admin.module.knowledge.dao.KbBaseDao">

    <sql id="baseColumns">
        tb.base_id,
        tb.name,
        tb.description,
        tb.doc_count,
        tb.create_user_id,
        tb.create_user_name,
        tb.create_time,
        tb.update_time
    </sql>

    <select id="queryPage" resultType="com.gklx.mopga.admin.module.knowledge.domain.vo.KbBaseVO">
        SELECT
        <include refid="baseColumns"/>
        FROM t_kb_base tb
        <where>
            <if test="queryForm.keyword != null and queryForm.keyword != ''">
                AND INSTR(tb.name, #{queryForm.keyword})
            </if>
        </where>
        ORDER BY tb.create_time DESC
    </select>

    <select id="queryByName" resultType="com.gklx.mopga.admin.module.knowledge.domain.entity.KbBaseEntity">
        SELECT *
        FROM t_kb_base
        WHERE name = #{name}
        <if test="excludeBaseId != null">
            AND base_id != #{excludeBaseId}
        </if>
        LIMIT 1
    </select>

</mapper>
