<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gklx.mopga.admin.module.generate.dao.LogTemplateCodeDao">

    <!-- 查询结果列 -->
    <sql id="base_columns">
        log_template_code.id,
        log_template_code.create_user_id,
        log_template_code.create_time,
        log_template_code.template_code_id,
        log_template_code.content,
        log_template_code.type
    </sql>

    <!-- 分页查询 -->
    <select id="queryPage" resultType="com.gklx.mopga.admin.module.generate.domain.vo.LogTemplateCodeVo">
        SELECT
        <include refid="base_columns"/>
        FROM log_template_code
    </select>
</mapper>