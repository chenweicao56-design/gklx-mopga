<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gklx.mopga.admin.module.requirement.dao.RequirementRepoRelDao">

    <select id="queryRepoIdList" resultType="java.lang.Long">
        SELECT repo_id
        FROM t_requirement_repo_rel
        WHERE requirement_id = #{requirementId}
    </select>

    <select id="countByRepoId" resultType="java.lang.Long">
        SELECT COUNT(1) FROM t_requirement_repo_rel WHERE repo_id = #{repoId}
    </select>

    <delete id="deleteByRequirementId">
        DELETE FROM t_requirement_repo_rel WHERE requirement_id = #{requirementId}
    </delete>

</mapper>
