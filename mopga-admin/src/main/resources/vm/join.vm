<select id="${functionName}" parameterType="${packageName}.domain.vo.${WordName}"
        resultMap="${WordName}Result">
    SELECT
    #if($t.CollectionIsNotEmpty($selects))
        #foreach($select in $selects)
    $select.tableAlias.$select.columnName#if($t.StringIsNotEmpty($select.columnAlias)) AS $select.columnAlias#end#if($velocityCount != $selects.size()),#end
        #end
    #end
    FROM ${mainTableName} as ${mainTableAlias}
    #if($t.CollectionIsNotEmpty($froms))
        #foreach($from in $froms)
    $from.joinType $from.tableName AS $from.tableAlias
            #foreach($on in $from.ons)
    $on.type  $on.tableAlias.$on.columnName = $on.targetTableAlias.$on.targetColumnName
            #end
        #end
    #end
    #if($t.CollectionIsNotEmpty($wheres))
    <where>
    #foreach($where in $wheres)
        #if($where.whereType == "EQ")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName = #{$where.fieldName}
        </if>
        #elseif($where.whereType == "NE")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName != #{$where.fieldName}
        </if>
        #elseif($where.whereType == "GT")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName > #{$where.fieldName}
        </if>
        #elseif($where.whereType == "GTE")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName >= #{$where.fieldName}
        </if>
        #elseif($where.whereType == "LT")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName < #{$where.fieldName}
        </if>
        #elseif($where.whereType == "LTE")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName <= #{$where.fieldName}
        </if>
        #elseif($where.whereType == "LIKE")
        <if test="$where.fieldName != null #if($where.fieldType == 'String' ) and $where.fieldName.trim() != ''#end">
            and $where.tableAlias.$where.columnName like concat('%', #{$where.fieldName}, '%')
        </if>
        #elseif($where.whereType == "BETWEEN")
        <if test="${where.fieldName}Start != null and ${where.fieldName}End != null">
            and $where.tableAlias.$where.columnName between #{${where.fieldName}Start}  and #{${where.fieldName}End}
        </if>
        #end
    #end
    </where>
    #end
    #if($t.CollectionIsNotEmpty($orderBys))
    GROUP BY #foreach($orderby in $orderBys) ${orderby.tableAlias}.${orderby.columnName} ${orderby.groupByType} #if ($velocityCount != $selects.size()),#end#end
    #end
    #if($limit)
    limit $limit.offset,$limit.limit
    #end
    
</select>